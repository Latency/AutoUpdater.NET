<Window x:Class="AutoUpdaterDotNET.Views.Window_DownloadUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Name="DownloadUpdateForm"
        Title="Remind me later for update"
        ResizeMode="NoResize"
        Margin="3,4,3,4"
        Height="499"
        Width="168">
    <Grid>
        <RadioButton Name="radioButtonYes"
                     Content="Yes, please remind me later : "/>
        <RadioButton Name="radioButtonNo"
                     Content="No, download updates now (recommended)"/>
        <Image Name="pictureBoxIcon"
               Height="79"
               Width="90"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               />
        <Label Name="labelTitle"
               Content="Do you want to download updates later?" />
        <Label Name="labelDescription"
               Content="You should download updates now. This only takes few minutes depending on your internet connection and ensures you have latest version of the application."/>
        <Button
            Content="buttonOK"
            Height="32"
            Width="115"
            Margin="10,3,10,3"/>
        <ComboBox Name="comboBoxRemindLater"
                  SelectedIndex="0"
                  Height="23"
                  Width="115">
            <ComboBoxItem Content="After 30 minutes" />
            <ComboBoxItem Content="After 12 hours" />
            <ComboBoxItem Content="After 1 day" />
            <ComboBoxItem Content="After 2 days" />
            <ComboBoxItem Content="After 4 days" />
            <ComboBoxItem Content="After 8 days" />
            <ComboBoxItem Content="After 10 days" />
        </ComboBox>
    </Grid>
</Window>
