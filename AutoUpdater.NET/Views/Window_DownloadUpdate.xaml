<!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
<controls:Window_Restricted
    x:Class="AutoUpdaterDotNET.Views.Window_DownloadUpdate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
    xmlns:converters="clr-namespace:AutoUpdaterDotNET.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModels:ViewModelDownloadUpdate}"
    Title="Download Updates"
    Width="450"
    Height="150"
    Icon="{StaticResource download}"
    Closing="OnClosing"
>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Closing">
            <b:InvokeCommandAction Command="{Binding CloseCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <controls:Window_Restricted.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter" />
    </controls:Window_Restricted.Resources>

    <Grid Margin="0, 10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
        <Image x:Name="PictureBoxIcon"
               Grid.Column="0"
               Grid.RowSpan="2"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="{StaticResource download}"
               Stretch="UniformToFill"
        />

        <Label
               Grid.Column="1"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="14"
               Content="{Binding LabelInformation}"
               d:Content="Downloading Update..."
        />

        <ProgressBar
            Grid.Column="1"
            Grid.Row="1"
            Height="40"
            Maximum="100"
            Value="{Binding DownloadStatistics.ProgressPercentage}"
        />

        <StackPanel
            Grid.Column="1"
            Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <TextBlock Text="{Binding DownloadStatistics.ProgressPercentage}" d:Text="100" />
            <TextBlock Text="%" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
        >
            <Label
                FontSize="8"
                VerticalAlignment="Bottom"
                Margin="0,0,0,-5"
                Content="Bytes Received:"
            />
            <Label
                FontSize="8"
                VerticalAlignment="Bottom"
                Content="{Binding DownloadStatistics.BytesReceived, Converter={StaticResource BytesToStringConverter}}" d:Text="10" />
            <Label
                FontSize="8"
                VerticalAlignment="Bottom"
                Content="/" />
            <Label
                FontSize="8"
                VerticalAlignment="Bottom"
                Content="{Binding DownloadStatistics.TotalBytesToReceive, Converter={StaticResource BytesToStringConverter}}" d:Text="13210" />
        </StackPanel>

    </Grid>
</controls:Window_Restricted>