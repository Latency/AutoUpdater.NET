<controls:Window_Restricted
    x:Class="AutoUpdaterDotNET.Views.Window_Config"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:enums="clr-namespace:AutoUpdaterDotNET.Enums"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:views="clr-namespace:AutoUpdaterDotNET.Views"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
    Width="400"
    Height="550"
    Title="Options"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModels:ViewModelConfig }"
    Loaded="Window_Main_OnLoaded"
>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded">
            <behaviors:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <controls:Window_Restricted.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <DataTemplate x:Key="SecurePasswordBox">
            <xctk:WatermarkPasswordBox
                Name="SecurePasswordBox"
                Watermark="Enter Password here..."
                WatermarkTemplate="{x:Null}"
                MaxLength="10"
                KeepWatermarkOnGotFocus="True"
                PasswordChanged="WatermarkPasswordBox_OnPasswordChanged"
            />
        </DataTemplate>
        <DataTemplate x:Key="UnsecuredPasswordBox">
            <xctk:WatermarkTextBox
                Name="UnsecuredPasswordBox"
                TextChanged="WatermarkPasswordBox_OnPasswordChanged"
            />
        </DataTemplate>
        <ObjectDataProvider
            x:Key="EncodingEnumValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Encodings" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="TimerDurationFormatEnumValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:RemindLaterFormat" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="UpdateModeEnumValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Mode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </controls:Window_Restricted.Resources>

    <Grid
        Margin="10"
        IsSharedSizeScope="True"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" SharedSizeGroup="B" />
            <ColumnDefinition Width="60" SharedSizeGroup="C" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ReSharper disable once InconsistentNaming -->
        <TextBlock
            Name="txtOptions"
            Margin="10,0,0,0"
            Text="Options"
            FontFamily="Vivaldi"
            FontWeight="Bold"
            FontSize="28"
            TextDecorations="Underline" />

        <StackPanel
            Orientation="Horizontal"
            Grid.Column="1"
            Grid.Row="0">
            <Button
                Name="ButtonLoad"
                Style="{StaticResource MyCustomButton}"
                Content="Load"
                Margin="6,6"
                ToolTip="Save the configuration settings."
                Command="{Binding LoadConfigCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

            <Button
                Name="ButtonSave"
                Content="Save"
                Margin="0,6"
                Style="{StaticResource MyCustomButton}"
                ToolTip="Load the configuration settings."
                Command="{Binding SaveConfigCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />
        </StackPanel>

        <Button
            Name="ButtonCancel"
            Grid.Row="0"
            Grid.Column="2"
            Width="50"
            Style="{StaticResource MyCustomButton}"
            Content="Cancel"
            ToolTip="Cancel the changes."
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CancelCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

        <Button
            Name="ButtonUpdate"
            Grid.Row="1"
            Grid.Column="2"
            Width="50"
            Style="{StaticResource MyCustomButton}"
            Content="Update"
            ToolTip="Start the update."
            IsEnabled="False"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding UpdateCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
        >
            <StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbRunUpdateAsAdmin"
                    IsChecked="{Binding Config.RunUpdateAsAdmin}"
                    ToolTip="Check this to run update process without admin privileges."
                    Content="Run Update As Admin"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbOpenDownloadPage"
                    IsChecked="{Binding Config.OpenDownloadPage}"
                    ToolTip="Check this to open the download page instead of downloading the update file when the user clicks on the download button."
                    Content="Open Download Page"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbUserSelectRemindLater"
                    IsChecked="{Binding Config.UserSelectRemindLater}"
                    ToolTip="Check this if you want to show the 'Remind Later' or 'Time' options within the AutoUpdater notification window."
                    Content="User Select Remind Later"
                />

                <StackPanel Orientation="Horizontal">

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudRemindLaterAt"
                        Value="{Binding Config.RemindLaterAt}"
                        Minimum="1"
                        ToolTip="Set the duration time."
                        HorizontalAlignment="Left"
                        Margin="10,0,0,0"
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbUserSelectRemindLater}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbUserSelectRemindLater}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <ComboBox
                        Name="cbRemindLaterTimeSpan"
                        ToolTip="Select the duration type."
                        ItemsSource="{Binding RemindLaterFormatEnumValues}"
                        SelectedValue="{Binding Config.RemindLaterTimeSpan}"
                        IsSynchronizedWithCurrentItem="True"
                        HorizontalAlignment="Left"
                        Margin="10,0,0,0"
                    >
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbUserSelectRemindLater}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbUserSelectRemindLater}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbIsManditory"
                    IsChecked="{Binding Config.IsMandatory}"
                    ToolTip="Check this if you want to show the 'ShowSkipButton' or 'ShowRemindLaterButton'."
                    Content="Is Mandatory"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbShowSkipButton"
                    IsChecked="{Binding Config.ShowSkipButton}"
                    ToolTip="Check this if you want to show the 'Skip' button."
                    Margin="10,0,0,0"
                    Content="Skip Button"
                >
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbShowRemindLaterButton"
                    IsChecked="{Binding Config.ShowRemindLaterButton}"
                    ToolTip="Check this if you want to show the 'Remind Later' button."
                    Margin="10,0,0,0"
                    Content="Remind Later Button"
                >
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <!-- ReSharper disable once InconsistentNaming -->
                <ComboBox
                    Name="cbUpdateMode"
                    ToolTip="Normal                - Ignores 'Remind Later' and 'Skip' values set previously and will hide both buttons.&#x0a;Forced                 - Same as Normal mode, minus showing the close box.&#x0a;ForcedDownload - Will start downloading and applying update without showing standard update dialog in addition to Forced mode behaviour."
                    ItemsSource="{Binding Source={StaticResource UpdateModeEnumValues}}"
                    SelectedValue="{Binding Config.UpdateMode}"
                    IsSynchronizedWithCurrentItem="True"
                    HorizontalAlignment="Left"
                    Width="150"
                    Margin="10,0,0,0"
                >
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="SelectedValue" Value="{x:Static enums:Mode.ForcedDownload}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbAppTitle"
                    ToolTip="Check this if you want to show a custom application title in AutoUpdater notification window."
                    Content="App Title"
                    IsChecked="{Binding Config.IsAppTitle}"
                />

                <StackPanel Orientation="Horizontal">
                    <Label Content="Title:   "
                           FontFamily="Courier New"
                           Margin="10,0,0,0"
                    >
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbAppTitle"
                        Text="{Binding Config.AppTitle}"
                        VerticalAlignment="Center"
                        Width="150"
                        ToolTip="Modify this to show a custom application title in AutoUpdater notification window."
                        TextChanged="TbAppTitle_OnTextChanged"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbReportErrors"
                    IsChecked="{Binding Config.ReportErrors}"
                    ToolTip="Check this if you want to show any errors."
                    Content="Report Errors"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbProxy"
                    IsChecked="{Binding Config.ProxyEnabled}"
                    ToolTip="Check this to configure web proxy credentials."
                    Content="Enable Proxy"
                />

                <StackPanel Orientation="Horizontal">
                    <Label Content="Uri:     "
                           FontFamily="Courier New"
                           Margin="10,0,0,0">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbProxyUri"
                        ToolTip="Check this to update file served only through Proxy."
                        Text="{Binding Config.ProxyUri}"
                        Width="150"
                        VerticalAlignment="Center"
                        PreviewTextInput="TbProxyUri_OnPreviewTextInput"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Username:"
                           FontFamily="Courier New"
                           Margin="10,0,0,0">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbProxyUsername"
                        ToolTip="Enter the username for the remote Proxy."
                        Text="{Binding Config.ProxyUserName}"
                        Width="150"
                        VerticalAlignment="Center"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Password:"
                           FontFamily="Courier New"
                           Margin="10,0,0,0">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbProxyPassword"
                        ToolTip="Enter the password for the remote Proxy, if applicable."
                        Text="{Binding Config.ProxyPassword}"
                        Width="150"
                        VerticalAlignment="Center"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbTimerEnabled"
                    IsChecked="{Binding Config.TimerEnabled}"
                    ToolTip="Check this if periodically check for updates."
                    Content="Enable Timer"
                />

                <StackPanel
                    Orientation="Horizontal">

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudTimers"
                        Value="{Binding Config.TimerInterval}"
                        Minimum="1"
                        HorizontalAlignment="Left"
                        ToolTip="Modify this for the interval value."
                        Margin="10,0,0,0"
                        Height="22"
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <ComboBox
                        Name="cbTimerDuration"
                        ToolTip="Select the interval duration within the combo-box."
                        ItemsSource="{Binding Source={StaticResource TimerDurationFormatEnumValues}}"
                        SelectedValue="{Binding Config.TimerDurationTimeSpan}"
                        IsSynchronizedWithCurrentItem="True"
                        HorizontalAlignment="Left"
                        Margin="10,0,0,0"
                        Height="22"
                    >
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TreeView
                        Name="tvTimers"
                        Margin="10,0,0,0"
                        BorderThickness="0"
                        ItemsSource="{Binding Config.TimerNodeList}"
                        MouseUp="Timers_OnMouseUp"
                    >
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbTimerEnabled}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbBasicAuth"
                    IsChecked="{Binding Config.IsBasicAuth}"
                    ToolTip="Check this to set basic authentication on credentials."
                    Content="Basic Authentication"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbBasicAuthChangeLog"
                    Margin="10,0,0,0"
                    IsChecked="{Binding Config.BasicAuthChangeLog}"
                    ToolTip="Check this to set provide basic authentication change log credentials needed to access update resources."
                    Content="Change Log"
                >
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbBasicAuthDownload"
                    Margin="10,0,0,0"
                    IsChecked="{Binding Config.BasicAuthDownload}"
                    ToolTip="Check this to set provide basic authentication download credentials needed to access update resources."
                    Content="Download"
                >
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Username:"
                           FontFamily="Courier New"
                           Margin="10,0,0,0">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbBasicAuthUserName"
                        ToolTip="Enter the username for the basic authentication."
                        Text="{Binding Config.BasicAuthUserName}"
                        Width="150"
                        VerticalAlignment="Center"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Password:"
                           FontFamily="Courier New"
                           Margin="10,0,0,0">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbBasicAuthPassword"
                        ToolTip="Enter the password for the basic authentication, if applicable."
                        Text="{Binding Config.BasicAuthPassword}"
                        Width="150"
                        VerticalAlignment="Center"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbBasicAuth}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbFTPProtocol"
                    IsChecked="{Binding Config.FtpProtocol}"
                    ToolTip="Check this if the protocol used is only able to be accessed via FTP."
                    Content="FTP instead of HTTP"
                />

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Expander
                        Name="FtpNetworkCredentials"
