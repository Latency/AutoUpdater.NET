<controls:Window_Restricted
    x:Class="AutoUpdaterDotNET.Views.Window_Config"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:enums="clr-namespace:AutoUpdaterDotNET.Enums"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:views="clr-namespace:AutoUpdaterDotNET.Views"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
    xmlns:dataTemplateSelectors="clr-namespace:AutoUpdaterDotNET.DataTemplateSelectors"
    xmlns:converters="clr-namespace:AutoUpdaterDotNET.Converters"
    ResizeMode="CanResizeWithGrip"
    Width="465"
    Height="400"
    Title="Configurations"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModels:ViewModelConfig }"
    Loaded="Window_Main_OnLoaded"
>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded">
            <behaviors:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <controls:Window_Restricted.Resources>
        <converters:FilePathConverter x:Key="FilePathConverter" />
        <Style TargetType="xctk:WatermarkTextBox" x:Key="WatermarkTextBox">
            <Setter Property="Watermark" Value="Enter the password" />
            <Setter Property="MaxLength" Value="10" />
            <Setter Property="KeepWatermarkOnGotFocus" Value="True" />
        </Style>
        <Style TargetType="xctk:PropertyGrid" x:Key="CustomPropertyGridStyle">
            <Setter Property="AutoGenerateProperties" Value="True" />
            <Setter Property="HideInheritedProperties" Value="False" />
            <Setter Property="IsCategorized" Value="False" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="ShowAdvancedOptions" Value="False" />
            <Setter Property="ShowDescriptionByTooltip" Value="True" />
            <Setter Property="ShowPreview" Value="False" />
            <Setter Property="ShowSearchBox" Value="False" />
            <Setter Property="ShowSortOptions" Value="False" />
            <Setter Property="ShowSummary" Value="False" />
            <Setter Property="ShowTitle" Value="False" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <DataTemplate x:Key="SecurePasswordBox">
            <xctk:WatermarkPasswordBox
                Name="SecurePasswordBox"
                Style="{StaticResource WatermarkTextBox}"
                PasswordChanged="WatermarkPasswordBox_OnPasswordChanged"
            />
        </DataTemplate>
        <DataTemplate x:Key="UnsecuredPasswordBox">
            <xctk:WatermarkTextBox
                Name="UnsecuredPasswordBox"
                Style="{StaticResource WatermarkTextBox}"
                TextChanged="WatermarkPasswordBox_OnPasswordChanged"
            />
        </DataTemplate>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <dataTemplateSelectors:PasswordBoxContentTemplate x:Key="PasswordBoxTemplateSelector"
                                                          SecurePasswordTemplate="{StaticResource SecurePasswordBox}"
                                                          UnsecuredPasswordTemplate="{StaticResource UnsecuredPasswordBox}" />

        <ObjectDataProvider
            x:Key="EncodingEnumValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Encodings" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="UpdateModeEnumValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Mode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </controls:Window_Restricted.Resources>

    <Grid
        Margin="10"
        IsSharedSizeScope="True"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition SharedSizeGroup="B" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ReSharper disable once InconsistentNaming -->
        <TextBlock
            Name="txtOptions"
            Margin="10,0,0,0"
            Text="Options"
            FontFamily="Vivaldi"
            FontWeight="Bold"
            FontSize="28"
            TextDecorations="Underline" />

        <StackPanel
            Orientation="Horizontal"
            Grid.Column="1"
            Grid.Row="0"
        >
            <Button
                Name="ButtonLoad"
                Style="{StaticResource MyCustomButton}"
                Content="Load"
                ToolTip="Save the configuration settings."
                Command="{Binding LoadConfigCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

            <Button
                Name="ButtonSave"
                Content="Save"
                Style="{StaticResource MyCustomButton}"
                ToolTip="Load the configuration settings."
                Command="{Binding SaveConfigCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

            <Button
                Name="ButtonCancel"
                Style="{StaticResource MyCustomButton}"
                Content="Cancel"
                ToolTip="Cancel the changes."
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />

            <Button
                Name="ButtonUpdate"
                Style="{StaticResource MyCustomButton}"
                Content="Update"
                ToolTip="Start the update."
                IsEnabled="False"
                Margin="2,0,0,0"
                Command="{Binding UpdateCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,0,5,0"
                >
                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbRunUpdateAsAdmin"
                        IsChecked="{Binding Config.RunUpdateAsAdmin, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to run update process without admin privileges."
                        Content="Run Update As Admin"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbClearAppDirectory"
                        IsChecked="{Binding Config.ClearAppDirectory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to clear application directory before update zip is extracted.&#x0a;This only works when using a zip file as an update file."
                        Content="Clear Application Directory"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbOpenDownloadPage"
                        IsChecked="{Binding Config.OpenDownloadPage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to open the download page instead of downloading the update file when the user clicks on the download button."
                        Content="Open Download Page"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbIsManditory"
                        IsChecked="{Binding Config.IsMandatory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this if you want to show the 'ShowSkipButton' or 'ShowRemindLaterButton'."
                        Content="Is Mandatory"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbShowSkipButton"
                        IsChecked="{Binding Config.ShowSkipButton, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this if you want to show the 'Skip' button."
                        Margin="10,0,0,0"
                        Content="Skip Button"
                    >
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbShowRemindLaterButton"
                        IsChecked="{Binding Config.ShowRemindLaterButton, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this if you want to show the 'Remind Later' button."
                        Margin="10,0,0,0"
                        Content="Remind Later Button"
                    >
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="10,0,0,0"
                    >

                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                        <xctk:UShortUpDown
                            Name="UiudRemindLaterAt"
                            Minimum="1"
                            ToolTip="Set the duration time."
                            HorizontalAlignment="Left"
                            Margin="10,0,0,0"
                            Value="{Binding Config.RemindLaterTimer.Interval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        >
                            <xctk:UShortUpDown.Style>
                                <Style TargetType="xctk:UShortUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbShowRemindLaterButton}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbShowRemindLaterButton}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </xctk:UShortUpDown.Style>
                        </xctk:UShortUpDown>

                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                        <ComboBox
                            Name="CbRemindLaterTimeSpan"
                            ToolTip="Select the duration type."
                            ItemsSource="{Binding RemindLaterFormatEnumValues}"
                            SelectedValue="{Binding Config.RemindLaterTimer.TimeSpan, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            IsSynchronizedWithCurrentItem="True"
                            HorizontalAlignment="Left"
                            Margin="10,0,0,0"
                        >
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsChecked, ElementName=cbShowRemindLaterButton}"
                                            Value="False"
                                        >
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsChecked, ElementName=cbShowRemindLaterButton}"
                                            Value="True"
                                        >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                    </StackPanel>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <ComboBox
                        Name="cbUpdateMode"
                        ToolTip="Normal                - Ignores 'Remind Later' and 'Skip' values set previously and will hide both buttons.&#x0a;Forced                 - Same as Normal mode, minus showing the close box.&#x0a;ForcedDownload - Will start downloading and applying update without showing standard update dialog in addition to Forced mode behaviour."
                        ItemsSource="{Binding Source={StaticResource UpdateModeEnumValues}}"
                        SelectedValue="{Binding Config.UpdateMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        IsSynchronizedWithCurrentItem="True"
                        HorizontalAlignment="Left"
                        Width="150"
                        Margin="10,0,0,0"
                    >
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsManditory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="SelectedValue" Value="{x:Static enums:Mode.ForcedDownload}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbAppTitle"
                        ToolTip="Check this if you want to show a custom application title in AutoUpdater notification window."
                        Content="App Title"
                        IsChecked="{Binding Config.IsAppTitle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    />

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Title:   "
                               FontFamily="Courier New"
                               Margin="10,0,0,0"
                        >
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>

                        <!-- ReSharper disable once InconsistentNaming -->
                        <TextBox
                            Name="tbAppTitle"
                            Text="{Binding Config.AppTitle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Width="150"
                            ToolTip="Modify this to show a custom application title in AutoUpdater notification window."
                            TextChanged="TbAppTitle_OnTextChanged"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbAppTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                    </StackPanel>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbReportErrors"
                        IsChecked="{Binding Config.ReportErrors, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this if you want to show any errors."
                        Content="Report Errors"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbProxy"
                        IsChecked="{Binding Config.ProxyEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to configure web proxy credentials."
                        Content="Enable Proxy"
                    />

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Uri:     "
                               FontFamily="Courier New"
                               Margin="10,0,0,0">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>

                        <!-- ReSharper disable once InconsistentNaming -->
                        <TextBox
                            Name="tbProxyUri"
                            ToolTip="Check this to update file served only through Proxy."
                            Text="{Binding Config.ProxyUri, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Width="150"
                            VerticalAlignment="Center"
                            PreviewTextInput="TbProxyUri_OnPreviewTextInput"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label
                            Content="Username:"
                            FontFamily="Courier New"
                            Margin="10,0,0,0"
                        >
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>

                        <!-- ReSharper disable once InconsistentNaming -->
                        <TextBox
                            Name="tbProxyUsername"
                            ToolTip="Enter the username for the remote Proxy."
                            Text="{Binding Config.ProxyUserName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Width="150"
                            VerticalAlignment="Center"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Password:"
                               FontFamily="Courier New"
                               Margin="10,0,0,0">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>

                        <!-- ReSharper disable once InconsistentNaming -->
                        <TextBox
                            Name="tbProxyPassword"
                            ToolTip="Enter the password for the remote Proxy, if applicable."
                            Text="{Binding Config.ProxyPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Width="150"
                            VerticalAlignment="Center"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=cbProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbCheckSynchronously"
                        IsChecked="{Binding Config.CheckSynchronously, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to update synchronously."
                        Content="Check Synchronously"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbDisableTopMost"
                        IsChecked="{Binding Config.TopMostDisabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to not set window as 'TopMost'.&#x0a;It is not standard to do this if TopMost is set 'false' in other windows."
                        Content="Top Most Disabled"
                    />

                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbDoNoBindOwnerWindow"
                        IsChecked="{Binding Config.DoNotBindOwnerWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this to not bind dialog windows to parent owner."
                        Content="Do Not Bind To Owner Window"
                    />

                </StackPanel>

                <StackPanel
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                >
                    <!-- ReSharper disable once InconsistentNaming -->
                    <CheckBox
                        Name="cbFTPProtocol"
                        IsChecked="{Binding Config.FtpProtocol, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        ToolTip="Check this if the protocol used is only able to be accessed via FTP."
                        Content="FTP instead of HTTP"
                        Checked="CbFTPProtocol_OnChecked"
                    />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <xctk:PropertyGrid
                            Name="FtpPropertyGrid"
                            SelectedObject="{Binding Config.FtpProfile, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomPropertyGridStyle}"
                            NameColumnWidth="180"
                            Loaded="FtpPropertyGrid_OnLoaded"
                        >
                            <xctk:PropertyGrid.EditorDefinitions>
                                <xctk:EditorTemplateDefinition TargetProperties="Domain">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <xctk:WatermarkTextBox Watermark="Enter the domain" />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="Password">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <ContentControl
                                                Loaded="PasswordTextBox_OnLoaded"
                                            />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="ShowPassword">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <CheckBox
                                                IsChecked="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Loaded="CbSecurePassword_OnLoaded"
                                                Click="SecurePassword_OnClick"
                                            />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="UserName">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <xctk:WatermarkTextBox Watermark="Enter the user name" />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="Encoding">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <ComboBox
                                                ItemsSource="{Binding Source={StaticResource EncodingEnumValues}}"
                                                SelectionChanged="CbEncoding_OnSelectionChanged"
                                                Loaded="CbEncoding_OnLoaded"
                                            />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="Host">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <xctk:WatermarkTextBox Watermark="Enter the host name" />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                            </xctk:PropertyGrid.EditorDefinitions>
                        </xctk:PropertyGrid>

                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbFTPProtocol}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <xctk:PropertyGrid
                            Name="HttpClientPropertyGrid"
                            SelectedObject="{Binding Config.HttpClient2, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomPropertyGridStyle}"
                            NameColumnWidth="250"
                            Loaded="HttpPropertyGrid_OnLoaded"
                        >
                            <xctk:PropertyGrid.EditorDefinitions>
                                <xctk:EditorTemplateDefinition TargetProperties="Timeout">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <xctk:TimeSpanUpDown
                                                Minimum="1"
                                                Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>

                                <xctk:EditorTemplateDefinition TargetProperties="MaxResponseContentBufferSize">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <xctk:ULongUpDown
                                                Minimum="1"
                                                Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                            </xctk:PropertyGrid.EditorDefinitions>
                        </xctk:PropertyGrid>

                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                >
                    <GroupBox Header="Overrides">
                        <StackPanel>

                            <!-- ReSharper disable once InconsistentNaming -->
                            <CheckBox
                                Name="cbExecutablePathOverride"
                                ToolTip="Check this to execute different executable after the update.&#x0a;This only works when using a zip file as an update file."
                                Content="Executable Path"
                            />

                            <StackPanel
                                Margin="15,0"
                                Orientation="Horizontal"
                            >
                                <Label Content="Path:">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>

                                <!-- ReSharper disable once InconsistentNaming -->
                                <TextBox
                                    Name="tbExecutablePathOverride"
                                    ToolTip="Enter the customized executable path to be executed after the update."
                                    Text="{Binding Config.ExecutablePathOverride, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource FilePathConverter}}"
                                    Width="150"
                                    Height="20"
                                >
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <!-- ReSharper disable once InconsistentNaming -->
                            <CheckBox
                                Name="cbInstallationPathOverride"
                                ToolTip="Check this to change the installation path."
                                Content="Installation Path"
                            />

                            <StackPanel
                                Margin="15,0"
                                Orientation="Horizontal">
                                <Label Content="Path:">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>

                                <!-- ReSharper disable once InconsistentNaming -->
                                <TextBox
                                    Name="tbInstallationPath"
                                    ToolTip="Enter the customized update zip extraction path."
                                    Text="{Binding Config.InstallationPathOverride, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource FilePathConverter}}"
                                    Width="150"
                                    Height="20"
                                >
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <!-- ReSharper disable once InconsistentNaming -->
                            <CheckBox
                                Name="cbWindowSizeOverride"
                                IsChecked="{Binding Config.WindowSizeOverride, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="Check this to override the window size."
                                Content="Window Size"
                                Loaded="WindowSizeOverride_OnLoaded"
                                Click="WindowSizeOverride_OnLoaded"
                            />

                            <!-- ReSharper disable once InconsistentNaming -->
                            <xctk:PropertyGrid
                                Name="WindowSizePropertyGrid"
                                SelectedObject="{Binding Config.WindowSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="Enter the window size to be overriden."
                            >
                                <xctk:PropertyGrid.Style>
                                    <Style TargetType="xctk:PropertyGrid" BasedOn="{StaticResource CustomPropertyGridStyle}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </xctk:PropertyGrid.Style>
                                <xctk:PropertyGrid.EditorDefinitions>
                                    <xctk:EditorTemplateDefinition TargetProperties="Height">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:DoubleUpDown 
                                                    Name="WindowSizeHeight"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    Minimum="0"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                    <xctk:EditorTemplateDefinition TargetProperties="Width">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:DoubleUpDown
                                                    Name="WindowSizeWidth"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    Minimum="0"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                </xctk:PropertyGrid.EditorDefinitions>
                                <xctk:PropertyGrid.PropertyDefinitions>
                                    <xctk:PropertyDefinition TargetProperties="IsEmpty" IsBrowsable="False" />
                                </xctk:PropertyGrid.PropertyDefinitions>
                            </xctk:PropertyGrid>

                            <!-- ReSharper disable once InconsistentNaming -->
                            <CheckBox
                                Name="cbInstalledVersionOverride"
                                IsChecked="{Binding Config.InstalledVersionOverride, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="Check this to assign installed version manually and don't want to rely on the library to determine the installed version from the originating assembly."
                                Content="Installed Version"
                                Loaded="VersionOverride_OnLoaded"
                                Click="VersionOverride_OnLoaded"
                            />

                            <xctk:PropertyGrid
                                Name="VersionPropertyGrid"
                                SelectedObject="{Binding Config.InstalledVersion, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="Modify the version to be overriden."
                            >
                                <xctk:PropertyGrid.Style>
                                    <Style TargetType="xctk:PropertyGrid" BasedOn="{StaticResource CustomPropertyGridStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </xctk:PropertyGrid.Style>
                                <xctk:PropertyGrid.EditorDefinitions>
                                    <xctk:EditorTemplateDefinition TargetProperties="Major">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:UIntegerUpDown 
                                                    Name="MajorVersion"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                    <xctk:EditorTemplateDefinition TargetProperties="Minor">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:UIntegerUpDown
                                                    Name="MinorVersion"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                    <xctk:EditorTemplateDefinition TargetProperties="Build">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:UIntegerUpDown 
                                                    Name="BuildVersion"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                    <xctk:EditorTemplateDefinition TargetProperties="Revision">
                                        <xctk:EditorTemplateDefinition.EditingTemplate>
                                            <DataTemplate>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <xctk:UIntegerUpDown
                                                    Name="RevisionVersion"
                                                    Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                />
                                            </DataTemplate>
                                        </xctk:EditorTemplateDefinition.EditingTemplate>
                                    </xctk:EditorTemplateDefinition>
                                </xctk:PropertyGrid.EditorDefinitions>
                            </xctk:PropertyGrid>

                            <!-- ReSharper disable once InconsistentNaming -->
                            <CheckBox
                                Name="cbIsIconOverride"
                                IsChecked="{Binding Config.IsIconOverride, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ToolTip="Check this to change the Icon shown on the updater dialog."
                                Content="Icon"
                            />

                            <StackPanel
                                Orientation="Horizontal"
                                Margin="10,0,0,0">
                                <Label Content="Image:">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>

                                <!-- ReSharper disable once InconsistentNaming -->
                                <Button
                                    Command="{Binding ImageChangeCommand}"
                                    Cursor="Hand"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}"
                                >
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Image
                                        Name="imgIcon"
                                        Stretch="UniformToFill"
                                        Width="100"
                                        Source="{Binding Config.TmpIcon}" />
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Delegates">
                        <StackPanel>
                            <!-- ReSharper disable once InconsistentNaming -->
                            <TreeView
                                Name="tvUpdateComplete"
                                BorderThickness="0"
                                ItemsSource="{Binding Config.UpdateCompleteNodeList}" />

                            <!-- ReSharper disable once InconsistentNaming -->
                            <TreeView
                                Name="tvBeforeCheckForUpdates"
                                BorderThickness="0"
                                ItemsSource="{Binding Config.BeforeCheckForUpdatesNodeList}" />

                            <!-- ReSharper disable once InconsistentNaming -->
                            <TreeView
                                Name="tvAfterCheckForUpdates"
                                BorderThickness="0"
                                ItemsSource="{Binding Config.AfterCheckForUpdatesNodeList}" />

                            <!-- ReSharper disable once InconsistentNaming -->
                            <TreeView
                                Name="tvTimers"
                                BorderThickness="0"
                                ItemsSource="{Binding Config.TimerNodeList}"
                                MouseUp="Timers_OnMouseUp"
                            />
                        </StackPanel>
                    </GroupBox>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <TextBlock Name="LabelVersion"
                   Grid.Column="1"
                   Grid.Row="2"
                   Text="{Binding Config.InstalledVersion}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="DarkSlateGray" />
    </Grid>

</controls:Window_Restricted>