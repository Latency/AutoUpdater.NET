                            x:Name="FtpCredentialsPropertyGrid"
                            SelectedObject="{Binding Config.FtpProfile.Credentials, FallbackValue=''}"
                            AutoGenerateProperties="False"
                            ShowSearchBox="False"
                            ShowSortOptions="False"
                            ShowTitle="False"
                            ShowSummary="False"
                            Margin="10,0,0,0"
                        >
                            <!-- Override the following properties in the PropertyGrid -->
                            <xctk:PropertyGrid.EditorDefinitions>
                                <xctk:EditorTemplateDefinition TargetProperties="Domain">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <TextBox />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                                <xctk:EditorTemplateDefinition TargetProperties="Password">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <ContentControl Loaded="PasswordTextBox_OnLoaded">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource UnsecuredPasswordBox}"/>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                                <xctk:EditorTemplateDefinition TargetProperties="SecurePassword">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <CheckBox Click="SecurePassword_OnClick" />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                                <xctk:EditorTemplateDefinition TargetProperties="UserName">
                                    <xctk:EditorTemplateDefinition.EditingTemplate>
                                        <DataTemplate>
                                            <TextBox />
                                        </DataTemplate>
                                    </xctk:EditorTemplateDefinition.EditingTemplate>
                                </xctk:EditorTemplateDefinition>
                            </xctk:PropertyGrid.EditorDefinitions>
                            <xctk:PropertyGrid.PropertyDefinitions>
                                <xctk:PropertyDefinition TargetProperties="Domain"             DisplayName="Domain" />
                                <xctk:PropertyDefinition TargetProperties="Password"           DisplayName="Password" />
                                <xctk:PropertyDefinition TargetProperties="SecurePassword"     DisplayName="Secure Password" />
                                <xctk:PropertyDefinition TargetProperties="UserName"           DisplayName="User Name" />
                            </xctk:PropertyGrid.PropertyDefinitions>
                        </xctk:PropertyGrid>
                    </Expander>
                    <Expander
                        Header="Encoding"
                        IsExpanded="False"
                        ExpandDirection="Down"
                    >
                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                        <xctk:PropertyGrid
                            Name="FtpEncodingPropertyGrid"
                            SelectedObject="{Binding Config.FtpProfile.Encoding}"
                            AutoGenerateProperties="False"
                            ShowAdvancedOptions="False"
                            ShowDescriptionByTooltip="False"
                            ShowPreview="False"
                            ShowSearchBox="False"
                            ShowSortOptions="False"
                            ShowSummary="False"
                            ShowTitle="False"
                            Margin="10,0,0,0"
                        >
                            <xctk:PropertyGrid.PropertyDefinitions>
                                <xctk:PropertyDefinition TargetProperties="BodyName" DisplayName="Name" />
                                <xctk:PropertyDefinition TargetProperties="CodePage" />
                                <xctk:PropertyDefinition TargetProperties="IsBrowserDisplay" />
                                <xctk:PropertyDefinition TargetProperties="IsBrowserSave" />
                                <xctk:PropertyDefinition TargetProperties="IsMailNewsDisplay" />
                                <xctk:PropertyDefinition TargetProperties="IsMailNewsSave" />
                                <xctk:PropertyDefinition TargetProperties="IsReadOnly" />
                                <xctk:PropertyDefinition TargetProperties="IsSingleByte" />
                                <xctk:PropertyDefinition TargetProperties="WindowsCodePage" />
                            </xctk:PropertyGrid.PropertyDefinitions>
                        </xctk:PropertyGrid>
                    </Expander>
                    <xctk:PropertyGrid
                        Name="FtpPropertyGrid"
                        AutoGenerateProperties="True"
                        IsCategorized="False"
                        SelectedObject="{Binding Config.FtpProfile}"
                        ShowAdvancedOptions="False"
                        ShowDescriptionByTooltip="False"
                        ShowPreview="False"
                        ShowSearchBox="False"
                        ShowSortOptions="False"
                        ShowSummary="False"
                        ShowTitle="False"
                        Margin="10,0,0,0"
                    >
                        <!-- Override the following properties in the PropertyGrid -->
                        <xctk:PropertyGrid.EditorDefinitions>
                            <xctk:EditorTemplateDefinition TargetProperties="Credentials">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Loaded="CbHasCredentials_OnLoaded"
                                            Unchecked="CbHasCredentials_OnUnchecked"
                                            Checked="CbHasCredentials_OnChecked"
                                        />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="RetryAttempts">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <xctk:IntegerUpDown Minimum="0" />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="Encoding">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Name="CbEncoding"
                                            SelectedIndex="0"
                                            ItemsSource="{Binding Source={StaticResource EncodingEnumValues}}"
                                            SelectionChanged="CbEncoding_OnSelectionChanged"
                                        >
                                        </ComboBox>
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="Host">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <xctk:WatermarkTextBox
                                            Watermark="Enter the hostname"
                                        />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="SocketPollInterval">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <xctk:IntegerUpDown Minimum="0" />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="Timeout">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <xctk:IntegerUpDown Minimum="0" />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                        </xctk:PropertyGrid.EditorDefinitions>
                        <xctk:PropertyGrid.PropertyDefinitions>
                            <xctk:PropertyDefinition TargetProperties="DataConnection"     DisplayName="Data Connection" />
                            <xctk:PropertyDefinition TargetProperties="SocketPollInterval" DisplayName="Socket Poll Interval" />
                            <xctk:PropertyDefinition TargetProperties="RetryAttempts"      DisplayName="Retry Attempts" />
                            <xctk:PropertyDefinition TargetProperties="EncodingVerified"   DisplayName="Encoding Verified" />
                        </xctk:PropertyGrid.PropertyDefinitions>
                    </xctk:PropertyGrid>

                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbClearAppDirectory"
                    IsChecked="{Binding Config.ClearAppDirectory}"
                    ToolTip="Check this to clear application directory before update zip is extracted.&#x0a;This only works when using a zip file as an update file."
                    Content="Clear Application Directory"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbExecutablePathOverride"
                    ToolTip="Check this to execute different executable after the update.&#x0a;This only works when using a zip file as an update file."
                    Content="Executable Path Override"
                />

                <StackPanel
                    Margin="15,0"
                    Orientation="Horizontal"
                >
                    <Label Content="Path:">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbExecutablePathOverride"
                        ToolTip="Enter the customized executable path to be executed after the update."
                        Text="{Binding Config.ExecutablePathOverride}"
                        Width="150"
                        Height="20"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbExecutablePathOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbInstallationPathOverride"
                    ToolTip="Check this to change the installation path."
                    Content="Installation Path Override"
                />

                <StackPanel
                    Margin="15,0"
                    Orientation="Horizontal">
                    <Label Content="Path:">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <TextBox
                        Name="tbInstallationPath"
                        ToolTip="Enter the customized update zip extraction path."
                        Text="{Binding Config.InstallationPathOverride}"
                        Width="150"
                        Height="20"
                    >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbInstallationPathOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbWindowSizeOverride"
                    IsChecked="{Binding Config.WindowSizeOverride}"
                    ToolTip="Check this to override the window size."
                    Content="Window Size Override"
                    Checked="CbWindowSizeOverride_OnChecked"
                />

                <StackPanel
                    Margin="15,0"
                    Orientation="Horizontal">
                    <Label Content="Size:">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:PropertyGrid
                        Name="WindowSizePropertyGrid"
                        ToolTip="Enter the window size to be overriden."
                        AutoGenerateProperties="False"
                        IsCategorized="False"
                        SelectedObject="{Binding Config.WindowSize}"
                        ShowAdvancedOptions="False"
                        ShowDescriptionByTooltip="False"
                        ShowPreview="False"
                        ShowSearchBox="False"
                        ShowSortOptions="False"
                        ShowSummary="False"
                        ShowTitle="False"
                    >
                        <xctk:PropertyGrid.Style>
                            <Style TargetType="xctk:PropertyGrid">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=cbWindowSizeOverride}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:PropertyGrid.Style>
                        <xctk:PropertyGrid.EditorDefinitions>
                            <xctk:EditorTemplateDefinition TargetProperties="Height">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <xctk:IntegerUpDown 
                                            Name="WindowSizeHeight"
                                            Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="1" />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                            <xctk:EditorTemplateDefinition TargetProperties="Width">
                                <xctk:EditorTemplateDefinition.EditingTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <xctk:IntegerUpDown
                                            Name="WindowSizeWidth"
                                            Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="1" />
                                    </DataTemplate>
                                </xctk:EditorTemplateDefinition.EditingTemplate>
                            </xctk:EditorTemplateDefinition>
                        </xctk:PropertyGrid.EditorDefinitions>
                        <xctk:PropertyGrid.PropertyDefinitions>
                            <xctk:PropertyDefinition TargetProperties="Height" />
                            <xctk:PropertyDefinition TargetProperties="Width" />
                        </xctk:PropertyGrid.PropertyDefinitions>
                    </xctk:PropertyGrid>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbCheckSynchronously"
                    IsChecked="{Binding Config.CheckSynchronously}"
                    ToolTip="Check this to update synchronously."
                    Content="Check Synchronously"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbInstalledVersionOverride"
                    IsChecked="{Binding Config.InstalledVersionOverride}"
                    ToolTip="Check this to assign installed version manually and don't want to rely on the library to determine the installed version from the originating assembly."
                    Content="Installed Version Override"
                />

                <StackPanel
                    Orientation="Horizontal"
                    Margin="10,0,0,0">

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudMajorVersion"
                        Value="{Binding Config.MajorVersion}"
                        DefaultValue="1"
                        Minimum="0"
                        HorizontalAlignment="Left"
                        ToolTip="Modify this for the interval value."
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                    <Label Content="."
                           FontWeight="Heavy"
                           VerticalAlignment="Bottom">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudMinorVersion"
                        Value="{Binding Config.MinorVersion}"
                        DefaultValue="0"
                        Minimum="0"
                        ToolTip="Modify this for the minor version's value."
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                    <Label Content="."
                           FontWeight="Heavy"
                           VerticalAlignment="Bottom">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudBuildVersion"
                        Value="{Binding Config.BuildVersion}"
                        DefaultValue="0"
                        Minimum="0"
                        ToolTip="Modify this for the build version's value."
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                    <Label Content="."
                           FontWeight="Heavy"
                           VerticalAlignment="Bottom">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <xctk:IntegerUpDown
                        Name="iudRevisionVersion"
                        Value="{Binding Config.RevisionVersion}"
                        DefaultValue="0"
                        Minimum="0"
                        ToolTip="Modify this for the sub-patch version's value."
                    >
                        <xctk:IntegerUpDown.Style>
                            <Style TargetType="xctk:IntegerUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbInstalledVersionOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:IntegerUpDown.Style>
                    </xctk:IntegerUpDown>

                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbDoNoBindOwnerWindow"
                    IsChecked="{Binding Config.DoNotBindOwnerWindow}"
                    ToolTip="Check this to not bind dialog windows to parent owner."
                    Content="Do Not Bind To Owner Window"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbDisableTopMost"
                    IsChecked="{Binding Config.TopMostDisabled}"
                    ToolTip="Check this to not set window as 'TopMost'.&#x0a;It is not standard to do this if TopMost is set 'false' in other windows."
                    Content="Top Most Disabled"
                />

                <!-- ReSharper disable once InconsistentNaming -->
                <CheckBox
                    Name="cbIsIconOverride"
                    IsChecked="{Binding Config.IsIconOverride}"
                    ToolTip="Check this to change the Icon shown on the updater dialog."
                    Content="Icon Override"
                />

                <StackPanel
                    Orientation="Horizontal"
                    Margin="10,0,0,0">
                    <Label Content="Image:">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

                    <!-- ReSharper disable once InconsistentNaming -->
                    <Button
                        Command="{Binding ImageChangeCommand}"
                        Cursor="Hand"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_Config}}}"
                    >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=cbIsIconOverride}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Image
                            Name="imgIcon"
                            Stretch="UniformToFill"
                            Width="100"
                            Source="{Binding Config.TmpIcon}" />
                    </Button>
                </StackPanel>

                <!-- ReSharper disable once InconsistentNaming -->
                <TreeView
                    Name="tvUpdateComplete"
                    BorderThickness="0"
                    ItemsSource="{Binding Config.UpdateCompleteNodeList}" />

                <!-- ReSharper disable once InconsistentNaming -->
                <TreeView
                    Name="tvBeforeCheckForUpdates"
                    BorderThickness="0"
                    ItemsSource="{Binding Config.BeforeCheckForUpdatesNodeList}" />

                <!-- ReSharper disable once InconsistentNaming -->
                <TreeView
                    Name="tvAfterCheckForUpdates"
                    BorderThickness="0"
                    ItemsSource="{Binding Config.AfterCheckForUpdatesNodeList}" />

            </StackPanel>
        </ScrollViewer>

        <TextBlock Name="LabelVersion"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Grid.Row="2"
                   Text="{Binding Config.InstalledVersion}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="DarkSlateGray" />
    </Grid>

</controls:Window_Restricted>