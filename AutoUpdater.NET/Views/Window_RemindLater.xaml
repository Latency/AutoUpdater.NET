<controls:RestrictedWindow x:Class="AutoUpdaterDotNET.Views.Window_RemindLater"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
        xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:ViewModelRemindLater }"
        Title="Remind me later for update"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="SingleBorderWindow"
        Width="500"
        Height="168"
        ControlBox="False"
        Icon="{StaticResource clock_go}"
>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="1"
            Grid.Row="2"
            Grid.RowSpan="2"
        >
            <RadioButton Name="RadioButtonYes"
                         Margin="0,5,0,5"
                         IsChecked="True"
                         Content="Yes, please remind me later"
                         GroupName="RemindLaterGroup"
                         Command="{Binding CommandRemindLater}"
                         CommandParameter="Yes"
            />
            <RadioButton Name="RadioButtonNo"
                 FontWeight="Bold"
                 Content="No, download updates now (recommended)"
                 GroupName="RemindLaterGroup"
                 Command="{Binding CommandRemindLater}"
                 CommandParameter="No"
            />
        </StackPanel>

        <Image Name="PictureBoxIcon"
               Grid.Column="0"
               Grid.Row="1"
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               Source="{StaticResource clock_go_32}"
               RenderOptions.BitmapScalingMode="Fant"
               Margin="0,-10,0,0"
               Stretch="Fill"
               Height="40"
               Width="40"
        />
        
        <Label Name="LabelTitle"
               Grid.Column="1"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="14"
               Content="Do you want to download updates later?"
        />

        <TextBlock Name="LabelDescription"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Grid.Column="1"
                   Grid.Row="1"
                   Text="You should download updates now. This only takes few minutes depending on your internet connection and ensures you have latest version of the application."
        />

        <ComboBox Name="ComboBoxRemindLater"
                  Grid.Column="2"
                  Grid.Row="1"
                  SelectedIndex="0"
                  Height="20"
                  FontSize="9"
                  VerticalAlignment="Top"
                  Margin="0,5,10,0"
        >
            <ComboBoxItem Content="After 30 minutes" />
            <ComboBoxItem Content="After 12 hours" />
            <ComboBoxItem Content="After 1 day" />
            <ComboBoxItem Content="After 2 days" />
            <ComboBoxItem Content="After 4 days" />
            <ComboBoxItem Content="After 8 days" />
            <ComboBoxItem Content="After 10 days" />
            <ComboBox.Style>
                <Style TargetType="ComboBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RadioButtonNo}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RadioButtonYes}" Value="True">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>

        <StackPanel
            Grid.Column="2"
            Grid.Row="2"
            Margin="0,3,10,8"       
        >
            <Button x:Name="ButtonOk">
                <WrapPanel>
                    <Image Source="{StaticResource clock_go_32}"
                           Width="15"
                           Height="15"
                           Margin="-10,3,5,0"
                    />
                    <TextBlock
                        Text="OK"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,3,0,0"
                        FontFamily="Courier New"
                        FontWeight="Bold"
                    />
                </WrapPanel>
            </Button>
        </StackPanel>

    </Grid>
</controls:RestrictedWindow>
