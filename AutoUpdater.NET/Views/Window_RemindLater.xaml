<controls:Window_Restricted
    BaseName="WindowRestricted"
    x:Class="AutoUpdaterDotNET.Views.Window_RemindLater"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
    xmlns:converters="clr-namespace:AutoUpdaterDotNET.Converters"
    xmlns:views="clr-namespace:AutoUpdaterDotNET.Views"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModels:ViewModelRemindLater }"
    Title="Remind me later for an update..."
    Width="500"
    Height="168"
    ResizeMode="NoResize"
    Icon="{StaticResource clock_go}"
>
    <controls:Window_Restricted.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </controls:Window_Restricted.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="1"
            Grid.Row="2"
        >
            <ListView x:Name="Config" ItemsSource="{Binding Config}" Visibility="Hidden" />

            <RadioButton
                Name="RadioButtonYes"
                Content="Yes, please remind me later"
                IsChecked="{Binding Config.UserSelectRemindLater}"
                GroupName="RemindLaterGroup"
            />
            <RadioButton
                Name="RadioButtonNo"
                Margin="0 5"
                FontWeight="Bold"
                Content="No, download updates now (recommended)"
                GroupName="RemindLaterGroup"
                IsChecked="{Binding Path=Config.UserSelectRemindLater, Converter={StaticResource InverseBoolConverter}}"
            />
        </StackPanel>

        <Image Name="PictureBoxIcon"
               Grid.Column="0"
               Grid.Row="1"
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               Source="{StaticResource clock_go}"
               RenderOptions.BitmapScalingMode="Fant"
               Margin="0,-10,0,0"
               Stretch="Fill"
               Height="40"
               Width="40" />

        <Label Name="LabelTitle"
               Grid.Column="1"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="14"
               Content="Do you want to download updates later?" />

        <TextBlock Name="LabelDescription"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Grid.Column="1"
                   Grid.Row="1"
                   Text="You should download updates now. This only takes few minutes depending on your internet connection and ensures you have latest version of the application." />

        <StackPanel
            Grid.Column="2"
            Grid.Row="1"
            Grid.RowSpan="2"
        >
            <ComboBox
                Name="ComboBoxRemindLater"
                SelectedIndex="0"
                Height="20"
                FontSize="9"
                VerticalAlignment="Top"
                Margin="10,5"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding ComboBoxItems}"
                SelectedItem="{Binding ComboBoxSelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="{Binding Key, Mode=OneWay}" />
                            <Run Text="{Binding Value, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RadioButtonNo}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RadioButtonYes}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <xctk:IntegerUpDown
                Height="20"
                Margin="10,5"
                Value="{Binding Config.RemindLaterAt}"
                Minimum="1"
                Visibility="Collapsed"
                x:Name="RemindLaterAt"
            >
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="ValueChanged">
                        <b:InvokeCommandAction
                            Command="{Binding RemindLaterAtChangedCommand}"
                            CommandParameter="{Binding ElementName=RemindLaterAt}"
                        />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </xctk:IntegerUpDown>

            <ComboBox
                x:Name="RemindLaterTimeSpan"
                FontSize="9"
                Height="20"
                Margin="10,5"
                Visibility="Collapsed"
                SelectedIndex="0"
                ItemsSource="{Binding RemindLaterFormatEnumValues}"
                SelectedValue="{Binding Path=Config.RemindLaterTimeSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            >
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction
                            Command="{Binding RemindLaterTimeSpanChangedCommand}"
                        />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ComboBox>

        </StackPanel>

        <Button
            Grid.Column="2"
            Grid.Row="2"
            Width="70"
            Height="30"
            x:Name="ButtonOk"
            Style="{StaticResource MyCustomButton}"
            Command="{Binding RemindLaterCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:Window_RemindLater}}}"
        >
            <WrapPanel>
                <Image Source="{StaticResource clock_go}"
                       Width="15"
                       Height="15"
                       Margin="-10,3,5,0" />
                <TextBlock
                    Text="OK"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,3,0,0"
                    FontFamily="Courier New"
                    FontWeight="Bold" />
            </WrapPanel>
        </Button>

    </Grid>
</controls:Window_Restricted>