<controls:RestrictedWindow x:Class="AutoUpdaterDotNET.Views.Window_Update"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AutoUpdaterDotNET.ViewModels"
        xmlns:controls="clr-namespace:AutoUpdaterDotNET.Controls"
        xmlns:views="clr-namespace:AutoUpdaterDotNET.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:ViewModelUpdate }"
        Title="Remind me later for update"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="SingleBorderWindow"
        Width="500"
        Height="168"
        ControlBox="False"
        Icon="{StaticResource update}"
>
    <controls:RestrictedWindow.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="300" ShadowDepth="3" BlurRadius="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>
    </controls:RestrictedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="PictureBoxIcon"
               Grid.Column="0"
               Grid.Row="1"
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               Source="{StaticResource update}"
               RenderOptions.BitmapScalingMode="Fant"
               Margin="0,-10,0,0"
               Stretch="Fill"
               Height="40"
               Width="40"
        />
        
        <Label x:Name="LabelTitle"
               Grid.Column="1"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="14"
               Content="A new version of {0} is available!"
        />

        <TextBlock x:Name="LabelDescription"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Grid.Column="1"
                   Grid.Row="1"
                   Text=" {0} is now available!  You have version {1} installed.  Would you liked to download it now?"
        />

        <Button x:Name="ButtonSkip"
            Grid.Column="1"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="-20,0,0,0"
            Command="{Binding CommandButtonSkip}"
            CommandParameter="{Binding RelativeSource=
                                   {RelativeSource
                                    Mode=FindAncestor,
                                    AncestorType={x:Type views:Window_Update}}}"
        >
            <WrapPanel>
                <Image Source="{StaticResource hand_point}"
                       Width="15"
                       Height="15"
                       Margin="-5,3,3,0"
                />
                <TextBlock
                    Text="Skip this version"
                    Margin="0,2,0,0"
                />
            </WrapPanel>
        </Button>

        <Button x:Name="ButtonRemindLater"
            Grid.Column="1"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="124,0,0,0"
            Command="{Binding CommandButtonRemindLater}"
            CommandParameter="{Binding RelativeSource=
                                   {RelativeSource
                                    Mode=FindAncestor,
                                    AncestorType={x:Type views:Window_Update}}}"
        >
            <WrapPanel>
                <Image Source="{StaticResource clock_go_32}"
                    Width="15"
                    Height="15"
                    Margin="-5,3,3,0"
                />
                <TextBlock
                    Text="Remind me later"
                    Margin="0,2,0,0"
                />
            </WrapPanel>
        </Button>

        <Button x:Name="ButtonUpdate"
            Grid.Column="2"
            Grid.Row="2"
            Margin="-30,0,0,0"
            Command="{Binding CommandButtonUpdate}"
            CommandParameter="{Binding RelativeSource=
                                   {RelativeSource
                                    Mode=FindAncestor,
                                    AncestorType={x:Type views:Window_Update}}}"
        >
            <WrapPanel>
                <Image Source="{StaticResource update}"
                    Width="15"
                    Height="15"
                    Margin="-5,3,3,0"
                />
                <TextBlock
                    Text="Update"
                    Margin="0,2,0,0"
                />
            </WrapPanel>
        </Button>

    </Grid>
</controls:RestrictedWindow>