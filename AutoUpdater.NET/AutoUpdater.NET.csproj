<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <TargetFramework>net10.0-windows</TargetFramework>
		<AssemblyTitle>AutoUpdater.NET</AssemblyTitle>
        <Description>AutoUpdater.NET is a class library that allows .NET developers to easily add auto update functionality to their WinForms or WPF application projects.</Description>
        <Nullable>enable</Nullable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Latency/AutoUpdater.NET</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/Latency/AutoUpdater.NET/releases</PackageReleaseNotes>
        <PackageTags>autoupdate updater c# wpf</PackageTags>
        <Product>AutoUpdater.NET</Product>
        <RootNamespace>AutoUpdaterDotNET</RootNamespace>
        <Title>AutoUpdater.NET</Title>
        <UseWpf>true</UseWpf>
        <Version>2.0.0</Version>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
        <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
	    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Views\DownloadUpdateDialog.cs" />
      <Compile Remove="Views\DownloadUpdateDialog.Designer.cs" />
    </ItemGroup>

	<ItemGroup>
      <ApplicationDefinition Include="Views\App.xaml" />
    </ItemGroup>

    <ItemGroup>
	    <PackageReference Include="AssemblyLoader" Version="1.2.3" />
	    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
	    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0-rc.1.25451.107" />
	    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0-rc.1.25451.107" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="png\clock_go.png" />
      <Resource Include="png\clock_play.png" />
      <Resource Include="png\download.png" />
      <Resource Include="png\hand_point.png" />
      <Resource Include="png\update.png" />
    </ItemGroup>

	<Import Project="D:\Source\Directory.PostBuild.props" Condition="Exists('D:\Source\Directory.PostBuild.props')" />

</Project>