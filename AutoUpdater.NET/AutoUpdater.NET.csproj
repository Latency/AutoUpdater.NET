<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net11.0-windows</TargetFrameworks>
		<Description>AutoUpdater.NET is a class library that incorporates auto update functionality into a project.</Description>
		<PackageTags>autoupdate updater c# wpf</PackageTags>
		<Product>AutoUpdater.NET</Product>
		<RootNamespace>AutoUpdaterDotNET</RootNamespace>
		<UseWpf>true</UseWpf>
		<Version>2.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
		<PackageReference Include="FluentFTP" Version="54.1.2" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\WindowService\WindowService\WindowService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\clock_go.png" />
		<Resource Include="Resources\clock_play.png" />
		<Resource Include="Resources\download.png" />
		<Resource Include="Resources\hand_point.png" />
		<Resource Include="Resources\update.png" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

</Project>