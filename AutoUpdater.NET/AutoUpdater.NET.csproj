<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
		<AssemblyTitle>AutoUpdater.NET</AssemblyTitle>
        <Description>AutoUpdater.NET is a class library that allows .NET developers to easily add auto update functionality to their WinForms or WPF application projects.</Description>
        <Nullable>enable</Nullable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Latency/AutoUpdater.NET</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/Latency/AutoUpdater.NET/releases</PackageReleaseNotes>
        <PackageTags>autoupdate updater c# wpf</PackageTags>
        <Product>AutoUpdater.NET</Product>
        <RootNamespace>AutoUpdaterDotNET</RootNamespace>
        <Title>AutoUpdater.NET</Title>
        <UseWpf>true</UseWpf>
        <Version>2.0.0</Version>
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Views\DownloadUpdateDialog.cs" />
      <Compile Remove="Views\DownloadUpdateDialog.Designer.cs" />
      <Compile Remove="Views\RemindLaterForm.cs" />
      <Compile Remove="Views\RemindLaterForm.Designer.cs" />
      <Compile Remove="Views\UpdateForm.cs" />
      <Compile Remove="Views\UpdateForm.Designer.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Views\DownloadUpdateDialog.resx" />
      <EmbeddedResource Remove="Views\UpdateForm.resx" />
    </ItemGroup>

    <ItemGroup>
	    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.5" />
	    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\clock_go.png" />
      <Resource Include="Resources\clock_go_32.png" />
      <Resource Include="Resources\clock_play.png" />
      <Resource Include="Resources\download.png" />
      <Resource Include="Resources\download_32.png" />
      <Resource Include="Resources\hand_point.png" />
      <Resource Include="Resources\update.png" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Window_DownloadUpdate.xaml.cs">
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>


	<Import Project="D:\Source\Directory.PostBuild.props" Condition="Exists('D:\Source\Directory.PostBuild.props')" />

</Project>