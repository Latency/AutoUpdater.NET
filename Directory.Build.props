<Project>

	<!-- Used for external side-chained MSBuild configurations.  *** DO NOT REMOVE *** -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../../'))"
	        Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../../')))" />

	<PropertyGroup>
		<ProjectIcon>Project.ico</ProjectIcon>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ProjectTitleOverride>gRPC with .NET Core</ProjectTitleOverride>
		<DefineConstants>$(DefineConstants);XILINX</DefineConstants>
		<ApplicationIcon>$(SolutionDir)$(ProjectIcon)</ApplicationIcon>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<Configurations>Debug;Release;Remote</Configurations>
	</PropertyGroup>

	<PropertyGroup
		Condition="!Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../../')))">
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="$(ApplicationIcon)" />
	</ItemGroup>

</Project>